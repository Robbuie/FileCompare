<Routine Name="MainRoutine" Type="RLL" LastModifiedDate="Mon Sep 28 13:50:00 2026">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[Start the spindle]]>
</Comment>
<Text>
<![CDATA[XIC(Start)OTE(Motor1.Run);]]>
